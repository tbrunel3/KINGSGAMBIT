# Godot 4 : dossier de cache/import genere localement
.godot/
/android/

# Exports
build/
*.translation

# OS / editeurs
.DS_Store
Thumbs.db
.vscode/
.idea/

# Etat local d'outils d'assistance (non lie au projet)
#
# ⚠️ `.claude/*` ET NON `.claude/` : git REFUSE de re-inclure un fichier dont
# le DOSSIER parent est exclu. Avec `.claude/`, les deux exceptions ci-dessous
# n'auraient servi a rien - et c'est silencieux, `git status` ne montre juste
# rien.
.claude/*

# LE GARDE-FOU GIT DOIT SUIVRE LE DEPOT. Le 25/08, ce depot avait 23 commits de
# retard sans que rien ne le dise, et une journee de travail a ete refaite en
# parallele. Un garde qui ne vit que sur une machine ne protege pas l'autre :
# c'est exactement le trou qu'il est cense boucher.
!.claude/settings.json
!.claude/launch.json

# Captures des bancs (regenerees a la demande par tools/screenshot.tscn,
# ui_test.tscn et resolutions.tscn) : sorties d'outil, pas des sources.
#
# Le .gdignore, lui, EST une source, et il doit survivre a un clone neuf :
# sans lui Godot importe les 128 captures comme des textures de jeu, et le
# lancement suivant les reimporte toutes. Mesure : 44 Mo de cache d'import et
# plus de cinq minutes de demarrage. D'ou le motif en deux temps - git ne
# descend pas dans un dossier ignore, une simple negation apres
# "tools/screenshots/" ne servirait a rien.
tools/screenshots/*
!tools/screenshots/.gdignore

# Build web (39 Mo de wasm + 17 Mo de pck a chaque export). Publie depuis la
# branche gh-pages, qui ne contient QUE lui - pas depuis main. Pour le mettre a
# jour : exporter, puis recopier docs/ a la racine de gh-pages.
# Voir README, sections "Regenerer les builds" et "Tester sur son telephone".
/docs/

# Certificat auto-signe du serveur de test local (tools/serve_local.py).
# Contient une CLE PRIVEE : jamais dans le depot, et regenere en une commande.
tools/*.pem

# Le carnet se rebatit depuis carnet/etat.json ; sa sortie est un produit.
carnet/build/
