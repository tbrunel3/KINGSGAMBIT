; Configuration du projet King's Gambit
;
; Les valeurs d'equilibrage du jeu ne sont PAS ici : voir scripts/data/balance.gd

config_version=5

[application]

config/name="King's Gambit"
config/description="Jeu de strategie fantasy inspire des echecs. MVP Phase 1."
run/main_scene="res://scenes/village/village.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Balance="*res://scripts/data/balance.gd"
SaveManager="*res://scripts/core/save_manager.gd"
Game="*res://scripts/core/game_state.gd"
Router="*res://scripts/core/router.gd"

[display]

window/size/viewport_width=393
window/size/viewport_height=852
window/size/window_width_override=393
window/size/window_height_override=852
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/default_font_multichannel_signed_distance_field=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
