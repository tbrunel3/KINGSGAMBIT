; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="King's Gambit"
config/description="Jeu de strategie fantasy inspire des echecs. MVP Phase 1."
config/version="1.2.0"
run/main_scene="res://scenes/intro/splash_screen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Balance="*res://scripts/data/balance.gd"
SaveManager="*res://scripts/core/save_manager.gd"
Game="*res://scripts/core/game_state.gd"
Router="*res://scripts/core/router.gd"
ScreenVeil="*res://scripts/ui/screen_veil.gd"

[display]

window/size/viewport_width=393
window/size/viewport_height=852
window/size/window_width_override=393
window/size/window_height_override=852
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

theme/default_font_multichannel_signed_distance_field=true
theme/custom="res://assets/theme/kings_gambit_theme.tres"

[input_devices]

; TOUT LE JEU ECOUTE LA SOURIS, ET IL N'Y A PAS UN SEUL InputEventScreenTouch
; DANS LE DEPOT. Il ne marche au doigt que grace a cette emulation - qui etait
; laissee a son defaut, donc vraie par accident et ecrite nulle part.
;
; On l'ecrit. La couper casserait le jeu entier d'un coup, et ce serait au
; moins visible ; la laisser implicite, c'est faire reposer tout le tactile sur
; une valeur que personne n'a choisie.
;
; ⚠️ SON COUT EST REEL, et c'est la fiche T : un SECOND doigt produit un SECOND
; appui emule. Voir grid_view._pointer_down, qui l'empeche de tuer le geste en
; cours.
pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
